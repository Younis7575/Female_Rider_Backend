# FemaleRider — production settings for IONOS Web Hosting (shared hosting: no Redis, no daemons).
# bootstrap.sh copies this to ../../.env and asks for the database password at a hidden prompt.
APP_NAME=FemaleRider
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://femalerider.mytechrcm.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=__DB_HOST__
DB_PORT=3306
DB_DATABASE=__DB_DATABASE__
DB_USERNAME=__DB_USERNAME__
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# Shared hosting: database-backed cache/queue, SQL driver presence, cron-driven worker.
SHARED_HOSTING=true
PRESENCE_DRIVER=sql
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Realtime: "null" → the app uses REST polling (works everywhere).
# For live sockets on shared hosting create a free Pusher Channels app and set:
#   BROADCAST_CONNECTION=pusher, PUSHER_APP_ID, PUSHER_APP_KEY, PUSHER_APP_SECRET, PUSHER_APP_CLUSTER
BROADCAST_CONNECTION=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mytechrcm.com"
MAIL_FROM_NAME="${APP_NAME}"

APP_CURRENCY=PKR
DEFAULT_COUNTRY_CODE=+92
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
TRUSTED_PROXIES=*

# OTP. Until an SMS provider is configured only the QA numbers below can sign in.
SMS_DRIVER=log
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_EXPOSE_IN_RESPONSE=false
OTP_TEST_NUMBERS=
OTP_TEST_CODE=

FIREBASE_PROJECT_ID=femalerider-a2c0f
FIREBASE_CREDENTIALS=storage/app/private/firebase/service-account.json
FCM_ENABLED=true

GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_REGION=pk
GEOAPIFY_API_KEY=
OPENROUTESERVICE_API_KEY=
# Low-volume testing only; add the free Geoapify / OpenRouteService keys before launch.
MAPS_ALLOW_PUBLIC_OSM=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
MAPS_USER_AGENT="FemaleRider/1.0 (femalerider.mytechrcm.com)"
MAPS_COUNTRY_CODES=pk

PAYMENT_GATEWAY=cash
PAYMENT_WEBHOOK_SECRET=
ADMIN_MFA_REQUIRED=true
SUPPORT_HOURS="Daily 08:00–23:00 PKT"
SUPPORT_PHONE=
SUPPORT_EMAIL=
