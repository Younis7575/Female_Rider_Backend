APP_NAME=FemaleRider
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=femalerider
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Reverb (WebSockets) — generate with `php artisan reverb:install` ----
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http
# Host/port the mobile app should connect to (defaults to REVERB_HOST/PORT). Set to your LAN IP for physical devices.
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=

# ---- FemaleRider business / integrations ----
APP_CURRENCY=PKR
DEFAULT_COUNTRY_CODE=+92
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
SANCTUM_STATEFUL_DOMAINS=
TRUSTED_PROXIES=127.0.0.1

# OTP / SMS. SMS_DRIVER=log writes codes to storage/logs/laravel.log (development only).
SMS_DRIVER=log
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Returns the OTP in the API response ONLY when APP_ENV=local|testing. Never enable elsewhere.
OTP_EXPOSE_IN_RESPONSE=false

# Firebase Cloud Messaging (HTTP v1). Service-account JSON stays on the server, never in Git or Flutter.
FIREBASE_PROJECT_ID=femalerider-a2c0f
FIREBASE_CREDENTIALS=storage/app/private/firebase/service-account.json
FCM_ENABLED=true

# Maps provider chain: Google (if key) → OpenStreetMap providers → offline estimate.
# Google Maps Platform server key (needs a billing account). Leave empty to use OpenStreetMap.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_REGION=pk
# Free OpenStreetMap-based providers (sign up with email, no card): geoapify.com, openrouteservice.org
GEOAPIFY_API_KEY=
OPENROUTESERVICE_API_KEY=
# Keyless public Nominatim/OSRM for development and low volume (default: on outside production).
# For production traffic use the keys above or self-host Nominatim/OSRM and point these URLs at them.
MAPS_ALLOW_PUBLIC_OSM=
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
MAPS_USER_AGENT="FemaleRider/1.0 (ride-hailing platform)"
MAPS_COUNTRY_CODES=pk

# Payments (cash at launch). Webhook HMAC secret for future gateways.
PAYMENT_GATEWAY=cash
PAYMENT_WEBHOOK_SECRET=

# Admin security
ADMIN_MFA_REQUIRED=true

# Public support details shown in the app/website
SUPPORT_HOURS="Daily 08:00–23:00 PKT"
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Development seeders only (DemoDataSeeder refuses to run in production)
DEMO_ADMIN_PASSWORD=

